# Optional MySQL configuration. If DB_URL is empty, SQLite is used when available.
# If the SQLite JDBC driver is unavailable, the app falls back to local text files.
DB_URL=jdbc:mysql://localhost:3306/smartcity?useSSL=true&serverTimezone=UTC
DB_USER=smartcity_app
DB_PASSWORD=CHANGE_ME

# One-time initial municipal administrator bootstrap.
# Use a unique password with at least 12 characters. Do not commit real values.
INITIAL_ADMIN_USER=municipal_admin
INITIAL_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
